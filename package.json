{
  "name": "geography-quiz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:data": "node scripts/ensure-data.mjs",
    "dev": "node scripts/ensure-data.mjs && vite",
    "build": "node scripts/ensure-data.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node scripts/ensure-data.mjs && vitest run",
    "e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "flag-icons": "^7.6.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
